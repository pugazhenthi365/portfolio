# ─── Public site ───────────────────────────────────────────────
# Canonical URL of the deployed site (no trailing slash). Used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── Supabase ──────────────────────────────────────────────────
# Project Settings → API. Both values are safe to expose to the browser;
# all data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NOTE: The service-role key is NOT used by this application. Never add it
# to any NEXT_PUBLIC_ variable or commit it to the repository.

# ─── Optional: Supabase keep-alive (Vercel Cron) ──────────────────────────
# Any long random string. Vercel sends it to /api/keepalive once a day so the
# free Supabase project is not paused for inactivity. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
